DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_dir.c>
DirectorySlash Off
</IfModule>

RewriteEngine On

# Mark parameterized URLs as noindex while keeping the normal response code.
RewriteCond %{QUERY_STRING} !^$
RewriteRule ^ - [E=robots_noindex:1]

<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, follow" env=robots_noindex
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 1. www -> non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ %{REQUEST_URI} [R=301,L]

# 2. Redirect direct requests for index/main aliases to canonical URLs
RewriteCond %{THE_REQUEST} \s/+(?:index|main)(?:\.html)?(?:[\s?]|$) [NC]
RewriteRule ^(?:index|main)(?:\.html)?$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+)/(?:index|main)(?:\.html)?(?:[\s?]|$) [NC]
RewriteRule ^(.+)/(?:index|main)(?:\.html)?$ /$1 [R=301,L]

# 3. Remove trailing slash from extensionless .html page URLs
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# 4. Remove trailing slash from directory index page URLs
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# 5. Remove .html from public URLs, except index/main aliases
RewriteCond %{THE_REQUEST} \s/+([^.]+?)\.html(?:[\s?]|$) [NC]
RewriteCond %1 !^(?:.*\/)?(?:index|main)$ [NC]
RewriteRule ^([^.]+?)\.html$ /$1 [R=301,L]

# 6. Internally serve directory index pages for clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# 7. Internally serve .html for clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+?)/?$ $1.html [L]
